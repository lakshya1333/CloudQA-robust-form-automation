{
  // Page under test. Override with --url <url|file>, or the CLOUDQA_URL environment variable.
  "Url": "https://app.cloudqa.io/home/AutomationPracticeForm",

  // chrome | edge | firefox   (override: --browser / CLOUDQA_BROWSER)
  "Browser": "chrome",
  // override: --headless / CLOUDQA_HEADLESS=true
  "Headless": false,

  // How long to keep looking for the fields (covers slow / dynamically rendered pages)
  "TimeoutSeconds": 15,
  // Look inside iframes if the fields are not found in the top page
  "SearchIframes": true,
  // Look inside open shadow roots
  "IncludeShadowDom": true,
  // Minimum confidence (0..~1.3) for a field to be accepted
  "MinScore": 0.45,
  // Where JSON reports and screenshots are written
  "ReportDirectory": "Reports",
  // Draw an outline around each field we act on (visible when not headless)
  "HighlightElements": true,

  // Values to enter. Override with --first-name / --gender / --state
  "TestData": {
    "FirstName": "John",
    "Gender": "Female",
    "State": "India"
  },

  // What each field MEANS. Matching is case/punctuation-insensitive and whole-word.
  // Keywords: strong evidence. WeakKeywords: low-weight hints. NegativeKeywords: evidence
  // that a candidate is a look-alike (e.g. "Last Name"), which pushes its score down.
  "Fields": {
    "FirstName": {
      "Keywords": [ "first name", "firstname", "fname", "f name", "given name", "forename", "first" ],
      "WeakKeywords": [ "name" ],
      "NegativeKeywords": [ "last", "lname", "surname", "family", "middle", "father", "mother", "spouse", "guardian", "parent", "nick", "nickname", "user", "username", "company", "maiden", "emergency", "search" ]
    },
    "Gender": {
      "Keywords": [ "gender", "sex" ],
      "WeakKeywords": [],
      "NegativeKeywords": [],
      "OptionVocabulary": [ "male", "female", "man", "woman", "transgender", "non binary", "nonbinary", "prefer not to say" ]
    },
    "State": {
      "Keywords": [ "state", "province", "region", "state province" ],
      "WeakKeywords": [],
      "NegativeKeywords": [ "country", "city", "shipping", "billing", "status" ],
      "OptionVocabulary": []
    }
  }
}
